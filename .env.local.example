# ===== Painel Admin =====
# Senha de acesso ao /admin. Fica só no servidor (sem prefixo NEXT_PUBLIC_).
ADMIN_PASSWORD=troque-esta-senha

# ===== Firebase (Realtime Database) =====
# Pegue estes valores em: console.firebase.google.com → seu projeto →
# Configurações do projeto (engrenagem) → Seus apps → App da Web → Configuração do SDK.
# Enquanto estiverem vazios, o site usa localStorage (só sincroniza no mesmo navegador).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
